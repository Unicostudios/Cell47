<!--
  Element skeleton for the clock face (336 × 336).
  Positions, colours and fonts are applied from app/config/*.js at startup,
  so this file only defines WHAT exists and the paint ORDER (later = on top).
  Every id here is looked up by app/ui/*.js — keep ids in sync.

  Text is a "label" (app/ui/label.js): a <g id="X-grp"> holding a system-font
  <text id="X"> fallback plus <image id="X-gN"> slots for bitmap-font glyphs.
-->
<svg id="root">
  <!-- Background layers -->
  <rect id="bg-solid" x="0" y="0" width="100%" height="100%" />
  <gradientRect id="bg-gradient" x="0" y="0" width="100%" height="100%"
    gradient-type="radial"
    gradient-x1="210" gradient-y1="170" gradient-x2="360" gradient-y2="360"
    gradient-color1="#3A3A3A" gradient-color2="#000000" />
  <image id="bg-image" x="0" y="0" width="336" height="336" display="none" />

  <!-- Status: battery -->
  <g id="grp-battery">
    <rect id="bat-top" x="0" y="0" width="0" height="0" />
    <rect id="bat-bottom" x="0" y="0" width="0" height="0" />
    <rect id="bat-left" x="0" y="0" width="0" height="0" />
    <rect id="bat-right" x="0" y="0" width="0" height="0" />
    <rect id="bat-nub" x="0" y="0" width="0" height="0" />
    <rect id="bat-level" x="0" y="0" width="0" height="0" />
    <g id="bat-text-grp">
      <text id="bat-text" x="0" y="0">--</text>
      <image id="bat-text-g0" x="0" y="0" width="0" height="0" display="none" />
      <image id="bat-text-g1" x="0" y="0" width="0" height="0" display="none" />
      <image id="bat-text-g2" x="0" y="0" width="0" height="0" display="none" />
      <image id="bat-text-g3" x="0" y="0" width="0" height="0" display="none" />
    </g>
  </g>

  <!-- Time & date -->
  <g id="date-grp">
    <text id="date" x="34" y="100">--</text>
    <image id="date-g0" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g1" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g2" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g3" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g4" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g5" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g6" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g7" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g8" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g9" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g10" x="0" y="0" width="0" height="0" display="none" />
    <image id="date-g11" x="0" y="0" width="0" height="0" display="none" />
  </g>
  <g id="time-grp">
    <text id="time" x="28" y="200">--</text>
    <image id="time-g0" x="0" y="0" width="0" height="0" display="none" />
    <image id="time-g1" x="0" y="0" width="0" height="0" display="none" />
    <image id="time-g2" x="0" y="0" width="0" height="0" display="none" />
    <image id="time-g3" x="0" y="0" width="0" height="0" display="none" />
    <image id="time-g4" x="0" y="0" width="0" height="0" display="none" />
  </g>

  <!-- Metric slots -->
  <g id="grp-metrics">
    <g id="slot0">
      <image id="slot0-icon" x="0" y="0" width="26" height="26" />
      <rect id="slot0-track" x="0" y="0" width="0" height="0" />
      <rect id="slot0-bar" x="0" y="0" width="0" height="0" />
      <g id="slot0-value-grp">
        <text id="slot0-value" x="0" y="0" text-anchor="middle">--</text>
        <image id="slot0-value-g0" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot0-value-g1" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot0-value-g2" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot0-value-g3" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot0-value-g4" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot0-value-g5" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot0-value-g6" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot0-value-g7" x="0" y="0" width="0" height="0" display="none" />
      </g>
      <!-- invisible touch target; pointer-events lets it receive taps -->
      <rect id="slot0-hit" x="0" y="0" width="0" height="0" opacity="0" pointer-events="visible" />
    </g>
    <g id="slot1">
      <image id="slot1-icon" x="0" y="0" width="26" height="26" />
      <rect id="slot1-track" x="0" y="0" width="0" height="0" />
      <rect id="slot1-bar" x="0" y="0" width="0" height="0" />
      <g id="slot1-value-grp">
        <text id="slot1-value" x="0" y="0" text-anchor="middle">--</text>
        <image id="slot1-value-g0" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot1-value-g1" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot1-value-g2" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot1-value-g3" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot1-value-g4" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot1-value-g5" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot1-value-g6" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot1-value-g7" x="0" y="0" width="0" height="0" display="none" />
      </g>
      <!-- invisible touch target; pointer-events lets it receive taps -->
      <rect id="slot1-hit" x="0" y="0" width="0" height="0" opacity="0" pointer-events="visible" />
    </g>
    <g id="slot2">
      <image id="slot2-icon" x="0" y="0" width="26" height="26" />
      <rect id="slot2-track" x="0" y="0" width="0" height="0" />
      <rect id="slot2-bar" x="0" y="0" width="0" height="0" />
      <g id="slot2-value-grp">
        <text id="slot2-value" x="0" y="0" text-anchor="middle">--</text>
        <image id="slot2-value-g0" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot2-value-g1" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot2-value-g2" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot2-value-g3" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot2-value-g4" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot2-value-g5" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot2-value-g6" x="0" y="0" width="0" height="0" display="none" />
        <image id="slot2-value-g7" x="0" y="0" width="0" height="0" display="none" />
      </g>
      <!-- invisible touch target; pointer-events lets it receive taps -->
      <rect id="slot2-hit" x="0" y="0" width="0" height="0" opacity="0" pointer-events="visible" />
    </g>
  </g>
</svg>
