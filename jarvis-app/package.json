{
  "name": "jarvis",
  "productName": "Jarvis",
  "version": "2.2.0",
  "description": "Jarvis for the Ops Desk dashboard: its own Mac window, always-on \"Jarvis\" listening, speech-to-text and voice on-device (free).",
  "main": "main.js",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/fetch-models.js",
    "start": "electron .",
    "app": "electron-builder --mac --dir --arm64",
    "check": "node -e \"require('./voice.js'); console.log('voice module OK')\"",
    "doctor": "node scripts/doctor.js"
  },
  "dependencies": {
    "@picovoice/pvrecorder-node": "1.2.9",
    "sherpa-onnx-node": "1.13.8"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.unico.jarvis",
    "productName": "Jarvis",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "voice.js",
      "voice-worker.js",
      "tts-worker.js",
      "loader.html",
      "settings.html",
      "settings-preload.js",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@picovoice/**",
      "node_modules/sherpa-onnx-node/**",
      "node_modules/sherpa-onnx-darwin-arm64/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis listens for \"Hey Jarvis\" on your Mac and turns what you say next into text, on the Mac.",
        "LSUIElement": false
      }
    },
    "npmRebuild": false
  }
}
