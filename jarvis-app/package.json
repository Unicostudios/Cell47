{
  "name": "jarvis",
  "productName": "Jarvis",
  "version": "1.0.0",
  "description": "Jarvis for the Ops Desk dashboard: its own Mac window, \"Hey Jarvis\" wake word, hands-free voice commands.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "app": "electron-builder --mac --dir",
    "check": "node -e \"require('./voice.js'); console.log('voice module OK')\""
  },
  "dependencies": {
    "@picovoice/porcupine-node": "4.0.2",
    "@picovoice/pvrecorder-node": "1.2.9"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "studio.unico.jarvis",
    "productName": "Jarvis",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "voice.js",
      "settings.html",
      "settings-preload.js",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@picovoice/**"
    ],
    "mac": {
      "target": [
        "dir"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Jarvis listens for \"Hey Jarvis\" and your voice commands. Audio stays on this Mac until you say the wake word.",
        "LSUIElement": false
      }
    },
    "npmRebuild": false
  }
}
